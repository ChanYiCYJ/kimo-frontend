{
  "name": "kimo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "cd ../kimo-fastapi && uvicorn app.main:app --reload --port 8000",
    "dev:all": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "preview": "vite preview",
    "deploy:cf": "npm run build && wrangler deploy",
    "dev:cf": "wrangler dev"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@milkdown/core": "^7.22.0",
    "@milkdown/ctx": "^7.22.0",
    "@milkdown/plugin-clipboard": "^7.22.0",
    "@milkdown/plugin-history": "^7.22.0",
    "@milkdown/plugin-listener": "^7.22.0",
    "@milkdown/plugin-prism": "^7.22.0",
    "@milkdown/plugin-upload": "^7.22.0",
    "@milkdown/preset-commonmark": "^7.22.0",
    "@milkdown/preset-gfm": "^7.22.0",
    "@milkdown/prose": "^7.22.0",
    "@milkdown/react": "^7.22.0",
    "@milkdown/utils": "^7.22.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.28.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/config": "^0.5.6",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
